# Resend Email API Key
# Get this from https://resend.com/api-tokens
RESEND_API_KEY=your_resend_api_key_here

# Stripe Publishable Key (safe to be public)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Secret Key (KEEP PRIVATE - never commit this!)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Application URL (used for redirects and email links)
# Set to your production domain when deploying
NEXT_PUBLIC_URL=http://localhost:3000

# Supabase (database, owner login, item photos)
# Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Square (optional 50% deposit collected online before the customer signs)
# Square Developer Console > your app > Credentials. Production values on the live site, Sandbox values for previews.
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
# Developer Console > Webhooks > your subscription > Signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key_here
# Supabase > Project Settings > API > service_role (secret, server only). Lets the server record a confirmed payment.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
